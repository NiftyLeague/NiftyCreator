  url: https://api.studio.thegraph.com/query/1645/nifty-league/1.0.0
  queries:
  - name: GetCharacters
    type: 0
    query: "query GetCharacters{\n    owner(  id :\"0x6ac131d20eec5d396030cb6d8b3fd34476e74c78\"
      ){\n        id\n        address\n        characters{\n            id\n           
      tokenId\n            traits{\n                tribe\n                skinColor\n               
      furColor\n                eyeColor\n                pupilColor\n               
      hair\n                mouth\n                beard\n                top\n               
      outerwear\n                print\n                bottom\n                footwear\n               
      belt\n                hat\n                eyewear\n                piercings\n               
      wrists\n                hands\n                neckwear\n                leftItem\n               
      rightItem\n            }\n        }\n    }\n}"
    queryString: owner
    returnType: Owner
    queryOptions:
    - contract
    - contracts
    - character
    - characters
    - traitMap
    - traitMaps
    - owner
    - owners
    - _meta
